# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=techcheck
DB_USER=techcheck_user
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera un secreto seguro con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
APP_NAME=TechCheck
APP_VERSION=2.0.0

# ── Superadmin inicial (solo se aplica en el primer db:seed:all) ──────────────
SUPERADMIN_EMAIL=admin@techcheck.com
SUPERADMIN_PASSWORD=cambia_esto_al_primer_login

# ── TLS para MySQL (opcional) ─────────────────────────────────────────────────
# Poner 'true' solo si MySQL está en un host separado y tiene TLS configurado.
# En producción con Docker en el mismo host, dejar en 'false'.
DB_SSL=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. Obligatorio en producción.
# Ejemplo: http://192.168.1.100:8080,https://techcheck.miempresa.com
CORS_ORIGIN=

# ── Puertos expuestos al host (Synology NAS) ──────────────────────────────────
# Evitar 80/443 si el NAS los usa. Usar reverse proxy de DSM hacia estos puertos.
APP_PORT=8080
ADMINER_PORT=8081
