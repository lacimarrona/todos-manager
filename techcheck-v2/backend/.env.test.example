# Variables para correr los tests del backend (Vitest + Supertest) contra una
# base de datos de test separada de la de desarrollo. Copiar a backend/.env.test
# (gitignored) y ajustar si hace falta.
#
# Requiere que la base "techcheck_test" exista en el mismo MySQL de docker-compose
# (ver backend/docker/init-test-db.sql, se crea sola en el primer arranque del
# volumen; si el volumen ya existía, crearla a mano una vez).

DB_HOST=mysql
DB_PORT=3306
DB_NAME=techcheck_test
DB_USER=techcheck_user
DB_PASSWORD=cambia_esta_contrasena

JWT_SECRET=solo_para_tests_no_usar_en_produccion
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

NODE_ENV=test
DB_SSL=false
CORS_ORIGIN=http://localhost:4200
